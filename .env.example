# Cosmirror API

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Astro engine: swiss (default) | skyfield (NASA JPL de421)
ASTRO_ENGINE=swiss

# LLM — персонализация разборов (опционально)
# Polza.ai: https://polza.ai/dashboard/api-keys
# LLM_PROVIDER=off — не звонить в API, в отчёте только fallback-тексты.
LLM_PROVIDER=auto
POLZA_API_KEY=
POLZA_BASE_URL=https://polza.ai/api/v1
POLZA_MODEL=openai/gpt-5.6-luna-pro
# Модель на задачу (не fallback). Пусто = поле model в core/prompts/*.md или POLZA_MODEL.
# Terra — короткий высокий слой. Luna — длинные вкладки отчёта.
# LLM_MODEL_ONBOARDING_INSIGHT=openai/gpt-5.6-terra-pro
# LLM_MODEL_EDITORIAL=openai/gpt-5.6-terra-pro
# LLM_MODEL_PAID_REPORT=openai/gpt-5.6-terra-pro
# LLM_MODEL_PAID_REPORT_NATAL=openai/gpt-5.6-luna-pro
# LLM_MODEL_PAID_REPORT_ASPECTS=openai/gpt-5.6-luna-pro
# LLM_MODEL_PAID_REPORT_CYCLES=openai/gpt-5.6-luna-pro
# LLM_MODEL_PAID_REPORT_REQUEST=openai/gpt-5.6-luna-pro
# LLM_MODEL_PAID_REPORT_PRACTICE=openai/gpt-5.6-luna-pro

# Groq fallback (legacy)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# Публичные URL
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://127.0.0.1:8000

# Яндекс ID — https://oauth.yandex.ru/ и https://yandex.ru/dev/id/doc/ru/
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
# Пусто = {FRONTEND_URL}/onboarding/contacts  (без завершающего слэша — так же в кабинете Яндекс OAuth)
YANDEX_OAUTH_REDIRECT_URI=

# Ключ, которым Next.js забирает JSON шары с сервера. Браузер его не знает.
# На проде задать длинный случайный секрет, одинаковый в API и web.
# SHARE_INTERNAL_KEY=

# Срок жизни входа после Яндекс ID (дни). Один токен — одно устройство.
# Без отдельного refresh 2 дня: потом снова Яндекс ID. На «Выйти» токен удаляется сразу.
AUTH_TOKEN_TTL_DAYS=2

# Инсайт: успех модели = стоп. Пока не вышло — до 3 попыток на сессию (сбой сети не лишает инсайта).
LLM_INSIGHT_ATTEMPTS_PER_SESSION=3

# Товар. Имя — в чеке (54-ФЗ). paid_content — «Доступы к материалам» на форме Prodamus.
COSMIRROR_PRODUCT_SKU=personal_report
COSMIRROR_PRODUCT_NAME=Персональный астрологический отчёт
COSMIRROR_PRODUCT_PRICE=777
COSMIRROR_PRODUCT_PAID_CONTENT=Персональный астрологический отчёт Cosmirror. После оплаты отправим отчёт на email, указанный при оформлении. https://cosmirror.ru

# Prodamus: https://help.prodamus.ru/payform/integracii/rest-api/instrukcii-dlya-samostoyatelnaya-integracii-servisov
# URL платёжной страницы вида https://your-subdomain.payform.ru/
PRODAMUS_FORM_URL=
PRODAMUS_SECRET_KEY=
# Код интеграции (sys). Нужен, чтобы сработал urlNotification из запроса.
PRODAMUS_SYS=
# 1 = demo_mode в ссылке + принимать демо-подпись webhook (secret + "demo")
PRODAMUS_DEMO_MODE=0
# Если пусто — {PUBLIC_API_URL}/api/payments/prodamus/webhook/

# Почта Cosmirror (REG.RU). Письма уходят с hello@cosmirror.ru
EMAIL_HOST=mail.hosting.reg.ru
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_HOST_USER=hello@cosmirror.ru
EMAIL_HOST_PASSWORD=
EMAIL_FROM=Cosmirror <hello@cosmirror.ru>
EMAIL_BCC=hello@cosmirror.ru
# Короткие счета do=link игнорируют ?ref=. Скидку передаём как discount_value.
# Формат: код:рубли,код2:рубли
PRODAMUS_PROMO_DISCOUNTS=test100:776

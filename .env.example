# Cosmirror API

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Astro engine: swiss (default) | skyfield (NASA JPL de421)
ASTRO_ENGINE=swiss

# LLM — персонализация разборов (опционально)
# Polza.ai: https://polza.ai/dashboard/api-keys
LLM_PROVIDER=auto
POLZA_API_KEY=
POLZA_BASE_URL=https://polza.ai/api/v1
POLZA_MODEL=openai/gpt-5.6-terra-pro

# Groq fallback (legacy)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# Публичные URL
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://127.0.0.1:8000

# Товар. Имя — в чеке (54-ФЗ). paid_content — «Доступы к материалам» на форме Prodamus.
COSMIRROR_PRODUCT_SKU=personal_report
COSMIRROR_PRODUCT_NAME=Персональный астрологический отчёт
COSMIRROR_PRODUCT_PRICE=777
COSMIRROR_PRODUCT_PAID_CONTENT=Персональный астрологический отчёт Cosmirror. После оплаты отправим отчёт на email, указанный при оформлении. https://cosmirror.ru

# Prodamus: https://help.prodamus.ru/payform/integracii/rest-api/instrukcii-dlya-samostoyatelnaya-integracii-servisov
# URL платёжной страницы вида https://your-subdomain.payform.ru/
PRODAMUS_FORM_URL=
PRODAMUS_SECRET_KEY=
# Код интеграции (sys). Нужен, чтобы сработал urlNotification из запроса.
PRODAMUS_SYS=
# 1 = demo_mode в ссылке + принимать демо-подпись webhook (secret + "demo")
PRODAMUS_DEMO_MODE=0
# Если пусто — {PUBLIC_API_URL}/api/payments/prodamus/webhook/

# Почта Cosmirror (REG.RU). Письма уходят с hello@cosmirror.ru
EMAIL_HOST=mail.hosting.reg.ru
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_HOST_USER=hello@cosmirror.ru
EMAIL_HOST_PASSWORD=
EMAIL_FROM=Cosmirror <hello@cosmirror.ru>
EMAIL_BCC=hello@cosmirror.ru
PRODAMUS_NOTIFICATION_URL=
